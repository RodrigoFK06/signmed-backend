# Copia este fichero a `.env` y ajusta los valores.

# --- Entorno ---
# development | staging | production
# Fuera de "development" la aplicacion NO arranca si SECRET_KEY sigue con su
# valor por defecto.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Seguridad ---
# Genera una clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Base de datos ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sign_language

# --- CORS ---
# Lista separada por comas con los origenes del frontend.
CORS_ORIGINS=http://localhost:3000

# --- Inferencia ---
# Umbral de confianza (%) para dar una prediccion por buena.
CONFIDENCE_THRESHOLD=75

# El modelo publicado se entreno SIN estandarizar las features, por lo que se
# sirve igual. Ponlo a true solo despues de reentrenar con la normalizacion
# activada (ver docs/MODEL_NOTES.md).
APPLY_FEATURE_NORMALIZATION=false

# --- Subidas ---
MAX_UPLOAD_BYTES=10485760
